# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PROYECTO GAVAC)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Pide al administrador de BD tus credenciales por mensaje privado
# 3. Reemplaza los valores entre < > con tus datos reales
# ==============================================================================

DATABASE_URL=mssql+pyodbc://<USUARIO>:<CLAVE>@<IP>,1433/Gavac?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no