# Copia este archivo como .env y ajusta los valores segun tu conexion.
#
# Para SQLite (por defecto, no necesitas hacer nada):
#   DATABASE_URL=sqlite:///./gavac.db
#
# Para SQL Server (ejemplo con autenticacion de Windows):
#   DATABASE_URL=mssql+pyodbc://@SERVIDOR\INSTANCIA/NombreBaseDatos?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&Encrypt=no
#
# Para SQL Server con usuario y contrasena:
#   DATABASE_URL=mssql+pyodbc://usuario:clave@SERVIDOR/NombreBaseDatos?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no

DATABASE_URL=
