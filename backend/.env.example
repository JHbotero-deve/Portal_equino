# Copia este archivo como .env y ajusta los valores segun tu conexion.
#
# Para SQLite (por defecto, no necesitas hacer nada):
#   DATABASE_URL=sqlite:///./gavac.db
#
# Para SQL Server (ejemplo con autenticacion de Windows, usando puerto 1433):
#   DATABASE_URL=mssql+pyodbc://@localhost,1433/Gavac?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&Encrypt=no
#
# Para SQL Server con usuario y contrasena (usando puerto 1433):
#   DATABASE_URL=mssql+pyodbc://usuario:clave@localhost,1433/Gavac?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no

DATABASE_URL=
